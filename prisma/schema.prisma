// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SP_DATABASE_URL")
  directUrl = env("SP_DATABASE_URL_UNPOOLED")
}

enum UserRole {
  SUPER_ADMIN
  PRIEST
  SERVANT_PREP
  MENTOR
  STUDENT
  SERVANT
  PARENT
}

// Compatibility-era role tags. The singular User.role remains until every
// authorization path has cut over to these historical grant rows.
enum RoleTag {
  SUPER_ADMIN
  PRIEST
  SERVANTS_PREP_SERVANT
  SERVANTS_PREP_STUDENT
  SUNDAY_SCHOOL_SERVANT
  SUNDAY_SCHOOL_STUDENT
  PARENT
}

enum RoleGrantSource {
  SUPER_ADMIN
  PREP_REGISTRATION
  PARENT_SIGNUP
  CHILD_REGISTRATION
  GUARDIAN_LINK
  SUNDAY_SCHOOL_ACCOUNT
  GRADUATION
  MIGRATION
  SYSTEM
}

enum SundaySchoolYearStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SundaySchoolRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SundaySchoolClassStatus {
  ACTIVE
  ARCHIVED
}

enum SundaySchoolEnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  GRADUATED
}

enum SundaySchoolRolloverDisposition {
  PROMOTE
  HOLD
  WITHDRAW
  GRADUATE
  OVERRIDE
}

enum SundaySchoolRosterImportStatus {
  PREVIEWED
  IN_PROGRESS
  COMMITTED
  FAILED
}

enum SundaySchoolRosterImportRowOutcome {
  CREATED
  MATCHED
  SKIPPED
  FAILED
}

enum SundaySchoolRolloverRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SundaySchoolRolloverItemStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}

enum AuditEventResult {
  SUCCESS
  DENIED
  FAILED
}

enum YearLevel {
  YEAR_1
  YEAR_2
}

enum EnrollmentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
}

enum ExamSectionType {
  BIBLE_STUDIES
  DOGMA
  COMPARATIVE_THEOLOGY
  RITUAL_THEOLOGY_SACRAMENTS
  CHURCH_HISTORY_COPTIC_HERITAGE
  SPIRITUALITY_OF_SERVANT
  PSYCHOLOGY_METHODOLOGY
  MISCELLANEOUS
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum SundaySchoolServantAttendanceStatus {
  PRESENT
  ABSENT
}

enum SundaySchoolChildGender {
  MALE
  FEMALE
}

enum LessonStatus {
  SCHEDULED
  CANCELLED
  NO_CLASS
  COMPLETED
}

enum ExamYearLevel {
  YEAR_1
  YEAR_2
  BOTH
}

enum SlipType {
  ATTENDANCE
  CONFESSION
}

// Retained only to describe the pre-slip async-note data that remains in the
// database during the deprecation window. Application code must not write it.
enum NoteSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SundaySchoolGrade {
  PRE_K
  KINDERGARTEN
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6_PLUS
}

// Grade levels for the Sunday School class itself (Sunday School mode).
// Separate from SundaySchoolGrade, which is the Servants Prep serving-verification
// bucket list and ends at GRADE_6_PLUS.
enum SundaySchoolLevel {
  PRE_K
  KINDERGARTEN
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  SPECIAL_NEEDS
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  // Legacy values retained so older databases can be migrated safely. New
  // records use the single combined COLLEGE_GRAD level.
  COLLEGE
  GRAD
  COLLEGE_GRAD
}

// Servant vs. coordinator, at whatever scope the assignment names
enum SundaySchoolAuthority {
  SERVANT
  COORDINATOR
}

enum SundaySchoolVisitationStatus {
  DONE
  NOT_DONE
}

enum SundaySchoolFeedbackStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum SundaySchoolFeedbackType {
  PROBLEM
  IDEA
}

enum SundaySchoolFeedbackVoteType {
  UP
  DOWN
}

enum SundaySchoolLogStatus {
  VERIFIED
  MANUAL
  EXCUSED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentGrade {
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  COLLEGE_FRESHMAN
  COLLEGE_SOPHOMORE
  COLLEGE_JUNIOR
  COLLEGE_SENIOR
  POST_COLLEGE
  OTHER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  // Normalized identity fields and authVersion are also maintained by a
  // database trigger so scripts and bulk updates cannot bypass the invariant.
  emailNormalized    String?   @unique
  username           String?
  usernameNormalized String?   @unique
  name               String
  password           String
  role               UserRole
  phone              String?
  profileImageUrl    String?
  serviceStartedOn   DateTime? @db.Date
  authVersion        Int       @default(1)
  mustChangePassword Boolean   @default(true)
  isDisabled         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  enrollments          StudentEnrollment[] @relation("StudentEnrollments")
  mentoredStudents     StudentEnrollment[] @relation("MentorServant")
  attendanceRecords    AttendanceRecord[]
  attendanceRecordedBy AttendanceRecord[]  @relation("RecordedBy")
  examScores           ExamScore[]
  examScoresGradedBy   ExamScore[]         @relation("GradedBy")
  lessonsCreated       Lesson[]            @relation("CreatedBy")
  studentNotes         StudentNote[]       @relation("StudentNotes")
  authoredNotes        StudentNote[]       @relation("AuthoredNotes")

  // Expected absence relations
  expectedAbsences        ExpectedAbsence[] @relation("StudentExpectedAbsences")
  createdExpectedAbsences ExpectedAbsence[] @relation("CreatedExpectedAbsences")

  // Async / slip relations
  asyncApprovedEnrollments StudentEnrollment[]   @relation("AsyncApprovedBy")
  slips                    StudentSlip[]         @relation("StudentSlips")
  uploadedSlips            StudentSlip[]         @relation("UploadedSlips")
  legacyNoteSubmissions    AsyncNoteSubmission[] @relation("StudentNoteSubmissions") @ignore
  legacyReviewedNotes      AsyncNoteSubmission[] @relation("ReviewedNoteSubmissions") @ignore

  // Sunday School relations
  sundaySchoolAssignments SundaySchoolAssignment[] @relation("SundaySchoolAssignments")
  assignedSundaySchool    SundaySchoolAssignment[] @relation("AssignedSundaySchool")
  generatedCodes          SundaySchoolCode[]       @relation("GeneratedCodes")
  markedSundaySchoolLogs  SundaySchoolLog[]        @relation("MarkedSundaySchoolLogs")

  // Sunday School mode relations (the Sunday School class itself)
  overseenSundaySchoolAgeGroups         SundaySchoolAgeGroup[]          @relation("SundaySchoolPriestOverseer")
  sundaySchoolServing                   SundaySchoolServantAssignment[] @relation("SundaySchoolServantAssignments")
  assignedSundaySchoolServants          SundaySchoolServantAssignment[] @relation("AssignedSundaySchoolServantAssignments")
  endedSundaySchoolServantAssignments   SundaySchoolServantAssignment[] @relation("EndedSundaySchoolServantAssignments")
  takenSundaySchoolSessions             SundaySchoolSession[]           @relation("TakenSundaySchoolSessions")
  recordedSundaySchoolChildAttendance   SundaySchoolChildAttendance[]   @relation("RecordedSundaySchoolAttendance")
  sundaySchoolServantAttendance         SundaySchoolServantAttendance[] @relation("SundaySchoolServantAttendance")
  recordedSundaySchoolServantAttendance SundaySchoolServantAttendance[] @relation("RecordedSundaySchoolServantAttendance")
  recordedSundaySchoolVisitations       SundaySchoolVisitation[]        @relation("RecordedSundaySchoolVisitations")
  authoredSundaySchoolPriestNotes       SundaySchoolPriestNote[]        @relation("SundaySchoolPriestNoteAuthor")
  submittedSundaySchoolFeedback         SundaySchoolFeedbackIdea[]      @relation("SubmittedSundaySchoolFeedback")
  sundaySchoolFeedbackVotes             SundaySchoolFeedbackVote[]      @relation("SundaySchoolFeedbackVotes")
  ownedSundaySchoolWeeklyLessons        SundaySchoolWeeklyLesson[]      @relation("SundaySchoolWeeklyLessonOwner")
  assignedSundaySchoolWeeklyLessons     SundaySchoolWeeklyLesson[]      @relation("SundaySchoolWeeklyLessonAssigner")
  linkedSundaySchoolChild               SundaySchoolChild?              @relation("SundaySchoolChildAccount")

  // Registration relations
  createdInviteCodes      InviteCode[]              @relation("InviteCodeCreator")
  reviewedRegistrations   RegistrationSubmission[]  @relation("RegistrationReviewer")
  createdFromRegistration RegistrationSubmission[]  @relation("RegistrationCreatedUser")
  annualMentorInformation AnnualMentorInformation[]

  // Servant application relations
  reviewedServantApplications   ServantApplication[] @relation("ServantApplicationReviewer")
  createdFromServantApplication ServantApplication[] @relation("ServantApplicationCreatedUser")

  // Parent portal relations
  guardianOfChildren          SundaySchoolChildGuardian[] @relation("GuardianOfChildren")
  submittedChildRegistrations ChildRegistrationRequest[]  @relation("ChildRegistrationSubmittedBy")
  reviewedChildRegistrations  ChildRegistrationRequest[]  @relation("ChildRegistrationReviewer")

  // OAuth relations
  accounts Account[]

  // Push notification relations
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Additive identity/authorization foundation. These relations become the
  // source of truth only after the compatibility backfill is reconciled.
  roleAssignments        UserRoleAssignment[]         @relation("RoleAssignmentUser")
  roleGrantsMade         UserRoleAssignment[]         @relation("RoleAssignmentGrantedBy")
  roleRevocationsMade    UserRoleAssignment[]         @relation("RoleAssignmentRevokedBy")
  mentorAssignments      MentorAssignment[]           @relation("MentorAssignmentMentor")
  mentorAssignmentsMade  MentorAssignment[]           @relation("MentorAssignmentAssignedBy")
  mentorAssignmentsEnded MentorAssignment[]           @relation("MentorAssignmentEndedBy")
  classPlacementsMoved   SundaySchoolClassPlacement[] @relation("SundaySchoolPlacementMovedBy")
  rosterImportsCreated   SundaySchoolRosterImport[]   @relation("SundaySchoolRosterImportCreatedBy")
  rolloverRunsTriggered  SundaySchoolRolloverRun[]    @relation("SundaySchoolRolloverTriggeredBy")
  auditEvents            AuditEvent[]                 @relation("AuditEventActor")
  guardianProfile        SundaySchoolGuardianProfile? @relation("SundaySchoolGuardianAccount")
  guardianLinksCreated   SundaySchoolChildGuardian[]  @relation("SundaySchoolGuardianLinkedBy")

  @@index([email])
  @@index([usernameNormalized])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model UserRoleAssignment {
  id          String          @id @default(cuid())
  userId      String
  tag         RoleTag
  source      RoleGrantSource
  grantedAt   DateTime        @default(now()) @db.Timestamptz(3)
  grantedById String?
  revokedAt   DateTime?       @db.Timestamptz(3)
  revokedById String?
  note        String?         @db.Text

  user      User  @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("RoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([tag, revokedAt])
  @@index([grantedById])
  @@index([revokedById])
}

model MentorAssignment {
  id                  String    @id @default(cuid())
  studentEnrollmentId String
  mentorUserId        String
  assignedById        String?
  assignedAt          DateTime  @default(now()) @db.Timestamptz(3)
  effectiveFrom       DateTime? @db.Date
  endedAt             DateTime? @db.Timestamptz(3)
  endedById           String?
  endReason           String?   @db.Text

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  mentor            User              @relation("MentorAssignmentMentor", fields: [mentorUserId], references: [id], onDelete: Restrict)
  assignedBy        User?             @relation("MentorAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  endedBy           User?             @relation("MentorAssignmentEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([studentEnrollmentId, endedAt])
  @@index([mentorUserId, endedAt])
  @@index([assignedById])
  @@index([endedById])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lessons                        Lesson[]
  exams                          Exam[]
  enrollments                    StudentEnrollment[]             @relation("EnrollmentYear")
  graduatedEnrollments           StudentEnrollment[]             @relation("GraduationYear")
  sundaySchoolAssignments        SundaySchoolAssignment[]
  sundaySchoolClasses            SundaySchoolClass[]
  sundaySchoolServantAssignments SundaySchoolServantAssignment[]
  annualMentorInformation        AnnualMentorInformation[]

  @@index([isActive])
}

model StudentEnrollment {
  id                      String           @id @default(cuid())
  studentId               String           @unique
  academicYearId          String? // The academic year this enrollment started in
  graduatedAcademicYearId String? // The academic year the student graduated in (if graduated)
  yearLevel               YearLevel
  mentorId                String?
  mentorName              String?
  mentorPhone             String?
  fatherOfConfessionId    String? // Reference to FatherOfConfession (not a User)
  isActive                Boolean          @default(true)
  status                  EnrollmentStatus @default(ACTIVE)
  notes                   String?          @db.Text
  enrolledAt              DateTime         @default(now())
  graduatedAt             DateTime? // When the student graduated
  graduationNote          String?          @db.Text // Required if graduating without meeting requirements (exception)
  updatedAt               DateTime         @default(now()) @updatedAt

  // Async student fields
  isAsyncStudent  Boolean   @default(false)
  asyncApprovedAt DateTime?
  asyncApprovedBy String?
  asyncReason     String?   @db.Text

  // Late-start attendance: lessons scheduled before this date are not counted
  // toward this student's attendance (auto-marked as EXCUSED / "joined later").
  attendanceStartDate DateTime?

  // Relations
  student               User                @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  mentor                User?               @relation("MentorServant", fields: [mentorId], references: [id])
  academicYear          AcademicYear?       @relation("EnrollmentYear", fields: [academicYearId], references: [id])
  graduatedAcademicYear AcademicYear?       @relation("GraduationYear", fields: [graduatedAcademicYearId], references: [id])
  fatherOfConfession    FatherOfConfession? @relation(fields: [fatherOfConfessionId], references: [id], onDelete: SetNull)
  asyncApprover         User?               @relation("AsyncApprovedBy", fields: [asyncApprovedBy], references: [id], onDelete: SetNull)
  mentorAssignments     MentorAssignment[]

  @@index([studentId])
  @@index([mentorId])
  @@index([isActive])
  @@index([status])
  @@index([academicYearId])
  @@index([graduatedAcademicYearId])
  @@index([fatherOfConfessionId])
  @@index([mentorId, isActive]) // Compound index for mentor filtering with active status
  @@index([mentorId, status]) // Compound index for mentor filtering with enrollment status
  @@index([isAsyncStudent])
}

model ExamSection {
  id                 String          @id @default(cuid())
  name               ExamSectionType @unique
  displayName        String
  passingScore       Int             @default(60)
  averageRequirement Int             @default(75)

  // Relations
  lessons Lesson[]
  exams   Exam[]
}

model Lesson {
  id                 String       @id @default(cuid())
  academicYearId     String
  examSectionId      String
  title              String
  subtitle           String?
  description        String?      @db.Text
  speaker            String?
  scheduledDate      DateTime
  status             LessonStatus @default(SCHEDULED)
  cancellationReason String?      @db.Text
  lessonNumber       Int
  isExamDay          Boolean      @default(false) // If true, attendance doesn't count toward percentage
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  academicYear      AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSection       ExamSection           @relation(fields: [examSectionId], references: [id])
  creator           User?                 @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  resources         LessonResource[]
  legacyAsyncNotes  AsyncNoteSubmission[] @ignore

  @@unique([academicYearId, lessonNumber])
  @@index([academicYearId])
  @@index([examSectionId])
  @@index([scheduledDate])
  @@index([status])
}

model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  url       String
  type      String?
  createdAt DateTime @default(now())

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  lessonId          String
  studentId         String
  status            AttendanceStatus
  arrivedAt         DateTime?
  notes             String?          @db.Text
  recordedBy        String?
  recordedAt        DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  conductRemoval    Boolean          @default(false) // True if student was removed from lesson for conduct
  conductNote       String?          @db.Text // Required reason when conductRemoval is true
  notEnrolledYet    Boolean          @default(false) // True if EXCUSED because the lesson predates the student's attendance start date (late start)
  expectedAbsenceId String? // Set when this record is covered by a planned/expected absence
  expectedAbsenceNA Boolean          @default(false) // True if marked N/A via an expected absence (excluded from the attendance rate)
  slipId            String? // Set when an async student's attendance slip marked this lesson PRESENT

  // Relations
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student         User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recorder        User?                @relation("RecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  slip            StudentSlip?         @relation(fields: [slipId], references: [id], onDelete: SetNull)
  expectedAbsence ExpectedAbsence?     @relation("ExpectedAbsenceRecords", fields: [expectedAbsenceId], references: [id], onDelete: SetNull)
  legacyAsyncNote AsyncNoteSubmission? @ignore

  @@unique([lessonId, studentId])
  @@index([lessonId])
  @@index([studentId])
  @@index([status])
  @@index([conductRemoval])
  @@index([notEnrolledYet])
  @@index([expectedAbsenceId])
  @@index([slipId])
  @@index([studentId, lessonId]) // Compound index for student+lesson queries
}

// A planned/expected absence for a student over a date range (e.g. travel).
// Lessons that fall within the range are marked ABSENT for the student with the
// reason carried into the attendance record's notes, and stay Absent until an
// admin manually excuses them. When markAsNA is true, covered lessons are
// instead marked N/A and excluded from the attendance rate entirely.
model ExpectedAbsence {
  id        String   @id @default(cuid())
  studentId String
  startDate DateTime
  endDate   DateTime
  reason    String   @db.Text
  markAsNA  Boolean  @default(false) // Covered lessons are N/A (excluded from the rate) instead of Absent
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student           User               @relation("StudentExpectedAbsences", fields: [studentId], references: [id], onDelete: Cascade)
  creator           User?              @relation("CreatedExpectedAbsences", fields: [createdBy], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[] @relation("ExpectedAbsenceRecords")

  @@index([studentId])
  @@index([startDate])
  @@index([endDate])
}

model Exam {
  id             String        @id @default(cuid())
  academicYearId String
  examSectionId  String
  yearLevel      ExamYearLevel
  examDate       DateTime
  totalPoints    Int           @default(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSection  ExamSection  @relation(fields: [examSectionId], references: [id])
  scores       ExamScore[]

  @@index([academicYearId])
  @@index([examSectionId])
  @@index([yearLevel])
}

model ExamScore {
  id         String   @id @default(cuid())
  examId     String
  studentId  String
  score      Float
  percentage Float
  notes      String?  @db.Text
  gradedBy   String?
  gradedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  exam    Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grader  User? @relation("GradedBy", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([studentId, examId]) // Compound index for student exam score lookups
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student User @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)
  author  User @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([authorId])
  @@index([createdAt])
}

model FatherOfConfession {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  church    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  students StudentEnrollment[]

  @@index([isActive])
  @@index([name])
}

// ============================================
// SLIPS (photos of signed paper slips, uploaded by servants)
// ============================================

// ATTENDANCE: an async student's signed attendance slip. The lessons it covers
//   are marked PRESENT and linked through AttendanceRecord.slipId.
// CONFESSION: a father-of-confession sign-off for the 2-month period starting
//   at periodStart (see lib/confession.ts).
model StudentSlip {
  id          String    @id @default(cuid())
  studentId   String
  type        SlipType
  imageUrl    String
  periodStart DateTime? // CONFESSION only
  uploadedBy  String?
  createdAt   DateTime  @default(now())

  // Relations
  student           User               @relation("StudentSlips", fields: [studentId], references: [id], onDelete: Cascade)
  uploader          User?              @relation("UploadedSlips", fields: [uploadedBy], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@unique([studentId, type, periodStart])
  @@index([type])
}

// Legacy async lesson-note submissions were replaced by StudentSlip. The table
// remains mapped so schema drift checks account for preserved production data,
// while @@ignore keeps it out of Prisma Client and prevents new application use.
model AsyncNoteSubmission {
  id                 String               @id @default(cuid())
  studentId          String
  lessonId           String
  content            String               @db.Text
  status             NoteSubmissionStatus @default(PENDING)
  submittedAt        DateTime             @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewFeedback     String?              @db.Text
  attendanceRecordId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  student          User              @relation("StudentNoteSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  lesson           Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviewer         User?             @relation("ReviewedNoteSubmissions", fields: [reviewedBy], references: [id], onDelete: SetNull)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@index([status])
  @@index([submittedAt])
  @@ignore
}

model SundaySchoolAssignment {
  id             String            @id @default(cuid())
  studentId      String
  grade          SundaySchoolGrade
  academicYearId String
  yearLevel      YearLevel
  totalWeeks     Int               @default(6)
  startDate      DateTime
  isActive       Boolean           @default(true)
  assignedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  student      User              @relation("SundaySchoolAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assigner     User?             @relation("AssignedSundaySchool", fields: [assignedBy], references: [id], onDelete: SetNull)
  logs         SundaySchoolLog[]

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([grade])
  @@index([isActive])
}

model SundaySchoolCode {
  id          String            @id @default(cuid())
  code        String            @unique
  grade       SundaySchoolGrade
  weekOf      DateTime
  validUntil  DateTime
  generatedBy String?
  generatedAt DateTime          @default(now())
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())

  // Relations
  generator User?             @relation("GeneratedCodes", fields: [generatedBy], references: [id], onDelete: SetNull)
  usages    SundaySchoolLog[]

  @@unique([grade, weekOf])
  @@index([code])
  @@index([grade])
  @@index([weekOf])
  @@index([validUntil])
}

model SundaySchoolLog {
  id           String                @id @default(cuid())
  assignmentId String
  weekNumber   Int
  weekOf       DateTime
  status       SundaySchoolLogStatus
  codeId       String?
  markedBy     String?
  notes        String?               @db.Text
  studentNotes String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // Relations
  assignment SundaySchoolAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  code       SundaySchoolCode?      @relation(fields: [codeId], references: [id], onDelete: SetNull)
  marker     User?                  @relation("MarkedSundaySchoolLogs", fields: [markedBy], references: [id], onDelete: SetNull)

  @@unique([assignmentId, weekNumber])
  @@index([assignmentId])
  @@index([status])
  @@index([weekOf])
}

// ============================================
// SUNDAY SCHOOL MODE MODELS
//
// These cover the Sunday School class itself: the classes, the children in
// them, and weekly attendance of those children. Separate from the models
// above (SundaySchoolAssignment / Code / Log), which exist only to verify
// that async Servants Prep students served their required weeks.
// ============================================

model SundaySchoolYear {
  id             String                 @id @default(cuid())
  name           String                 @unique
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  status         SundaySchoolYearStatus @default(DRAFT)
  previousYearId String?                @unique
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  previousYear               SundaySchoolYear?               @relation("SundaySchoolYearSequence", fields: [previousYearId], references: [id], onDelete: SetNull)
  nextYear                   SundaySchoolYear?               @relation("SundaySchoolYearSequence")
  ageGroups                  SundaySchoolAgeGroup[]
  classes                    SundaySchoolClass[]
  enrollments                SundaySchoolEnrollment[]
  assignments                SundaySchoolServantAssignment[]
  rosterImports              SundaySchoolRosterImport[]
  registrationRequests       ChildRegistrationRequest[]
  rolloverRunsAsSource       SundaySchoolRolloverRun[]       @relation("SundaySchoolRolloverSourceYear")
  rolloverRunsAsTarget       SundaySchoolRolloverRun[]       @relation("SundaySchoolRolloverTargetYear")
  sundaySchoolAgeGroupLevels SundaySchoolAgeGroupLevel[]

  @@index([status, startDate, endDate])
}

model SundaySchoolClass {
  id                 String                  @id @default(cuid())
  name               String // e.g. "Grade 3 Boys"
  level              SundaySchoolLevel
  // Required: authority over a class is scoped to its academic year, so a
  // class with no year would be a class nobody can be assigned to.
  academicYearId     String
  sundaySchoolYearId String?
  sectionName        String                  @default("General")
  status             SundaySchoolClassStatus @default(ACTIVE)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // A class has no ageGroupId: its band is whichever SundaySchoolAgeGroup
  // lists its `level`. One source of truth, so moving a grade between bands
  // re-parents its classes with no data migration.

  // Relations
  academicYear              AcademicYear                    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sundaySchoolYear          SundaySchoolYear?               @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  assignments               SundaySchoolServantAssignment[]
  children                  SundaySchoolChild[]
  placements                SundaySchoolClassPlacement[]
  rosterImports             SundaySchoolRosterImport[]
  sessions                  SundaySchoolSession[]
  weeklyLessons             SundaySchoolWeeklyLesson[]
  childRegistrationRequests ChildRegistrationRequest[]
  visitations               SundaySchoolVisitation[]

  @@unique([name, academicYearId])
  @@unique([sundaySchoolYearId, level, sectionName])
  @@unique([id, sundaySchoolYearId])
  @@unique([id, sundaySchoolYearId, level])
  @@index([level])
  @@index([isActive])
  @@index([academicYearId])
  @@index([sundaySchoolYearId, status])
}

model SundaySchoolAgeGroup {
  overseerId         String?
  overseer           User?                    @relation("SundaySchoolPriestOverseer", fields: [overseerId], references: [id], onDelete: SetNull)
  id                 String                   @id @default(cuid())
  sundaySchoolYearId String?
  name               String // "Elementary", "Middle School", "High School"
  levels             SundaySchoolLevel[] // the grades this band owns
  sortOrder          Int                      @default(0)
  status             SundaySchoolRecordStatus @default(ACTIVE)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Invariant enforced in the API (Prisma cannot express it): a level belongs
  // to at most one age group, or a class would sit in two bands at once.

  sundaySchoolYear SundaySchoolYear?               @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  assignments      SundaySchoolServantAssignment[]
  levelRows        SundaySchoolAgeGroupLevel[]

  @@unique([sundaySchoolYearId, name])
  @@unique([id, sundaySchoolYearId])
  @@index([overseerId])
  @@index([isActive])
  @@index([sundaySchoolYearId, status])
}

model SundaySchoolAgeGroupLevel {
  id                 String            @id @default(cuid())
  sundaySchoolYearId String
  ageGroupId         String
  level              SundaySchoolLevel
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)

  sundaySchoolYear SundaySchoolYear     @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  ageGroup         SundaySchoolAgeGroup @relation(fields: [ageGroupId, sundaySchoolYearId], references: [id, sundaySchoolYearId], onDelete: Restrict)

  @@unique([sundaySchoolYearId, level])
  @@unique([ageGroupId, level])
  @@index([ageGroupId])
}

model SundaySchoolServantAssignment {
  id                 String                @id @default(cuid())
  userId             String
  academicYearId     String
  sundaySchoolYearId String?
  authority          SundaySchoolAuthority

  // Exactly one of classId / ageGroupId is set. Validated in the API: Prisma
  // cannot express the constraint, and Postgres unique indexes treat NULLs as
  // distinct, so duplicates are caught by an explicit pre-check too.
  classId    String?
  ageGroupId String?

  assignedBy String?
  assignedAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt    DateTime? @db.Timestamptz(3)
  endedById  String?
  endReason  String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user             User                  @relation("SundaySchoolServantAssignments", fields: [userId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sundaySchoolYear SundaySchoolYear?     @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  class            SundaySchoolClass?    @relation(fields: [classId, sundaySchoolYearId], references: [id, sundaySchoolYearId], onDelete: Restrict)
  ageGroup         SundaySchoolAgeGroup? @relation(fields: [ageGroupId, sundaySchoolYearId], references: [id, sundaySchoolYearId], onDelete: Restrict)
  assigner         User?                 @relation("AssignedSundaySchoolServantAssignments", fields: [assignedBy], references: [id], onDelete: SetNull)
  endedBy          User?                 @relation("EndedSundaySchoolServantAssignments", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([userId, academicYearId])
  @@index([classId])
  @@index([ageGroupId])
  @@index([academicYearId])
  @@index([sundaySchoolYearId, endedAt])
  @@index([userId, endedAt])
  @@index([endedById])
}

model SundaySchoolChild {
  id            String                   @id @default(cuid())
  firstName     String
  lastName      String
  level         SundaySchoolLevel
  classId       String?
  familyId      String?
  userId        String?                  @unique
  birthDate     DateTime?
  gender        SundaySchoolChildGender?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  notes         String?                  @db.Text
  status        SundaySchoolRecordStatus @default(ACTIVE)
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Relations
  class               SundaySchoolClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  family              SundaySchoolFamily?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  user                User?                         @relation("SundaySchoolChildAccount", fields: [userId], references: [id], onDelete: SetNull)
  attendance          SundaySchoolChildAttendance[]
  visitations         SundaySchoolVisitation[]
  guardians           SundaySchoolChildGuardian[]   @relation("ChildGuardians")
  registrationRequest ChildRegistrationRequest?     @relation("ChildRegistrationCreatedChild")
  enrollments         SundaySchoolEnrollment[]
  rosterImportRows    SundaySchoolRosterImportRow[]

  @@index([classId])
  @@index([familyId])
  @@index([level])
  @@index([isActive])
  @@index([status])
  @@index([lastName, firstName])
}

model SundaySchoolEnrollment {
  id                   String                          @id @default(cuid())
  childId              String
  sundaySchoolYearId   String
  level                SundaySchoolLevel
  status               SundaySchoolEnrollmentStatus    @default(ACTIVE)
  previousEnrollmentId String?                         @unique
  rolloverDisposition  SundaySchoolRolloverDisposition @default(PROMOTE)
  nextLevelOverride    SundaySchoolLevel?
  enrolledAt           DateTime                        @default(now()) @db.Timestamptz(3)
  endedAt              DateTime?                       @db.Timestamptz(3)
  createdAt            DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                        @updatedAt @db.Timestamptz(3)

  child                 SundaySchoolChild             @relation(fields: [childId], references: [id], onDelete: Restrict)
  sundaySchoolYear      SundaySchoolYear              @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  previousEnrollment    SundaySchoolEnrollment?       @relation("SundaySchoolEnrollmentSequence", fields: [previousEnrollmentId], references: [id], onDelete: SetNull)
  nextEnrollment        SundaySchoolEnrollment?       @relation("SundaySchoolEnrollmentSequence")
  placements            SundaySchoolClassPlacement[]
  attendance            SundaySchoolChildAttendance[]
  visitations           SundaySchoolVisitation[]
  rolloverItemsAsSource SundaySchoolRolloverItem[]    @relation("SundaySchoolRolloverSourceEnrollment")
  rolloverItemAsTarget  SundaySchoolRolloverItem?     @relation("SundaySchoolRolloverTargetEnrollment")
  rosterImportRows      SundaySchoolRosterImportRow[]
  registrationRequest   ChildRegistrationRequest?     @relation("ChildRegistrationEnrollment")

  @@unique([childId, sundaySchoolYearId])
  @@unique([id, sundaySchoolYearId, level])
  @@index([sundaySchoolYearId, status])
  @@index([childId, status])
}

model SundaySchoolClassPlacement {
  id                 String            @id @default(cuid())
  enrollmentId       String
  classId            String
  sundaySchoolYearId String
  level              SundaySchoolLevel
  startedAt          DateTime          @default(now()) @db.Timestamptz(3)
  endedAt            DateTime?         @db.Timestamptz(3)
  movedById          String?
  moveReason         String?           @db.Text
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)

  enrollment  SundaySchoolEnrollment        @relation(fields: [enrollmentId, sundaySchoolYearId, level], references: [id, sundaySchoolYearId, level], onDelete: Restrict)
  class       SundaySchoolClass             @relation(fields: [classId, sundaySchoolYearId, level], references: [id, sundaySchoolYearId, level], onDelete: Restrict)
  movedBy     User?                         @relation("SundaySchoolPlacementMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  attendance  SundaySchoolChildAttendance[]
  visitations SundaySchoolVisitation[]

  @@unique([id, enrollmentId])
  @@index([enrollmentId, endedAt])
  @@index([classId, endedAt])
  @@index([movedById])
}

// Shared household information. A child belongs to at most one family, while
// a family can connect siblings across multiple Sunday School classes.
model SundaySchoolFamily {
  id          String   @id @default(cuid())
  name        String?
  homeAddress String?  @db.Text
  motherName  String?
  motherPhone String?
  motherEmail String?
  fatherName  String?
  fatherPhone String?
  fatherEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  children SundaySchoolChild[]

  @@index([name])
}

// A future-facing Sunday School lesson plan. It is deliberately independent
// from SundaySchoolSession: planning a lesson must not create attendance data
// or make a future Sunday look completed.
model SundaySchoolWeeklyLesson {
  id           String   @id @default(cuid())
  classId      String
  sundayDate   DateTime
  title        String?
  ownerId      String?
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class     SundaySchoolClass                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  owner     User?                              @relation("SundaySchoolWeeklyLessonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assigner  User?                              @relation("SundaySchoolWeeklyLessonAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  resources SundaySchoolWeeklyLessonResource[]

  @@unique([classId, sundayDate])
  @@index([sundayDate])
  @@index([ownerId, sundayDate])
}

model SundaySchoolWeeklyLessonResource {
  id             String   @id @default(cuid())
  weeklyLessonId String
  title          String
  url            String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  weeklyLesson SundaySchoolWeeklyLesson @relation(fields: [weeklyLessonId], references: [id], onDelete: Cascade)

  @@unique([weeklyLessonId, sortOrder])
  @@index([weeklyLessonId])
}

model SundaySchoolSession {
  id        String   @id @default(cuid())
  classId   String
  date      DateTime
  topic     String?
  notes     String?  @db.Text
  takenBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  class             SundaySchoolClass               @relation(fields: [classId], references: [id], onDelete: Cascade)
  taker             User?                           @relation("TakenSundaySchoolSessions", fields: [takenBy], references: [id], onDelete: SetNull)
  attendance        SundaySchoolChildAttendance[]
  servantAttendance SundaySchoolServantAttendance[]

  @@unique([classId, date])
  @@index([classId, date])
  @@index([date])
}

model SundaySchoolChildAttendance {
  id           String           @id @default(cuid())
  sessionId    String
  childId      String
  enrollmentId String?
  placementId  String?
  status       AttendanceStatus
  notes        String?          @db.Text
  recordedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  session    SundaySchoolSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child      SundaySchoolChild           @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment SundaySchoolEnrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  placement  SundaySchoolClassPlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)
  recorder   User?                       @relation("RecordedSundaySchoolAttendance", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, childId])
  @@index([sessionId])
  @@index([childId])
  @@index([enrollmentId])
  @@index([placementId])
  @@index([status])
}

model SundaySchoolServantAttendance {
  id         String                              @id @default(cuid())
  sessionId  String
  servantId  String
  status     SundaySchoolServantAttendanceStatus
  recordedBy String?
  createdAt  DateTime                            @default(now())
  updatedAt  DateTime                            @updatedAt

  session  SundaySchoolSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  servant  User                @relation("SundaySchoolServantAttendance", fields: [servantId], references: [id], onDelete: Cascade)
  recorder User?               @relation("RecordedSundaySchoolServantAttendance", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([sessionId, servantId])
  @@index([sessionId])
  @@index([servantId])
  @@index([status])
}

model SundaySchoolVisitation {
  id           String                       @id @default(cuid())
  classId      String
  childId      String
  enrollmentId String?
  placementId  String?
  status       SundaySchoolVisitationStatus @default(NOT_DONE)
  visitedAt    DateTime?
  notes        String?                      @db.Text
  recordedBy   String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  class       SundaySchoolClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  child       SundaySchoolChild           @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollment  SundaySchoolEnrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  placement   SundaySchoolClassPlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)
  recorder    User?                       @relation("RecordedSundaySchoolVisitations", fields: [recordedBy], references: [id], onDelete: SetNull)
  priestNotes SundaySchoolPriestNote[]

  @@index([classId, createdAt])
  @@index([childId, createdAt])
  @@index([enrollmentId, createdAt])
  @@index([placementId, createdAt])
  @@index([status])
}

// Confidential pastoral notes are deliberately separate from visitation
// notes so they can never be included accidentally by the general visitation
// API. Only the author and users with an active PRIEST role tag may read them.
model SundaySchoolPriestNote {
  id           String   @id @default(cuid())
  visitationId String
  authorId     String
  content      String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  visitation SundaySchoolVisitation @relation(fields: [visitationId], references: [id], onDelete: Restrict)
  author     User                   @relation("SundaySchoolPriestNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([visitationId, createdAt])
  @@index([authorId, createdAt])
}

// Product ideas for the Sunday School side of the application. These are
// intentionally global rather than scoped to a class or academic year.
model SundaySchoolFeedbackIdea {
  id            String                     @id @default(cuid())
  type          SundaySchoolFeedbackType   @default(IDEA)
  title         String
  description   String?                    @db.Text
  status        SundaySchoolFeedbackStatus @default(OPEN)
  submittedById String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  submitter User?                      @relation("SubmittedSundaySchoolFeedback", fields: [submittedById], references: [id], onDelete: SetNull)
  votes     SundaySchoolFeedbackVote[]

  @@index([status, createdAt])
  @@index([submittedById])
}

model SundaySchoolFeedbackVote {
  id        String                       @id @default(cuid())
  ideaId    String
  userId    String
  vote      SundaySchoolFeedbackVoteType
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  idea SundaySchoolFeedbackIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User                     @relation("SundaySchoolFeedbackVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([ideaId, vote])
  @@index([userId])
}

// ============================================
// REGISTRATION SYSTEM MODELS
// ============================================

model SystemSettings {
  id                  String   @id @default("default")
  registrationEnabled Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model InviteCode {
  id         String    @id @default(cuid())
  code       String    @unique
  label      String? // Human-readable label, e.g. "Fall 2026 Registration"
  maxUses    Int       @default(1) // 0 = unlimited
  usageCount Int       @default(0)
  expiresAt  DateTime? // null = never expires
  isActive   Boolean   @default(true)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  creator       User                     @relation("InviteCodeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  registrations RegistrationSubmission[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

model RegistrationSubmission {
  id           String             @id @default(cuid())
  inviteCodeId String
  status       RegistrationStatus @default(PENDING)

  // Applicant info
  email                   String
  fullName                String
  dateOfBirth             DateTime
  phone                   String
  fatherOfConfessionName  String?
  previouslyServed        Boolean
  previousServiceLocation String? // Only if previouslyServed = true
  currentlyServing        Boolean
  previouslyAttendedPrep  Boolean
  previousPrepLocation    String? // Only if previouslyAttendedPrep = true
  grade                   StudentGrade

  // Approval form upload
  approvalFormUrl      String? // Vercel Blob URL
  approvalFormFilename String? // Original filename for display

  // Profile image upload
  profileImageUrl      String? // Vercel Blob URL for profile picture
  profileImageFilename String? // Original filename for display

  // Mentor info
  mentorName  String?
  mentorPhone String?
  mentorEmail String?

  // Review fields
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?   @db.Text // Admin note (reason for rejection, etc.)
  createdUserId String? // Linked User.id: set at submission for returning users, or on approval for new ones

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  inviteCode  InviteCode @relation(fields: [inviteCodeId], references: [id])
  reviewer    User?      @relation("RegistrationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdUser User?      @relation("RegistrationCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)

  @@index([inviteCodeId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// Mentor contact details are confirmed again when a student begins Year 2.
// A separate record preserves the original admission application while making
// the Year 2 renewal explicit and auditable for each academic year.
model AnnualMentorInformation {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  mentorName     String
  mentorPhone    String
  mentorEmail    String
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
}

// Sunday School servant volunteer application. Deliberately separate from
// RegistrationSubmission: no invite code, no father-of-confession/grade/
// mentor/upload fields, and approval must be SUPER_ADMIN-only (see
// canReviewServantApplications in lib/roles.ts) rather than SERVANT_PREP too.
// Approving creates a User{role: SERVANT} but never a
// SundaySchoolServantAssignment — class/age-group assignment stays a
// separate step through the existing servant-assignments flow.
model ServantApplication {
  id     String             @id @default(cuid())
  status RegistrationStatus @default(PENDING)

  email        String
  fullName     String
  phone        String
  availability String? @db.Text // Legacy compatibility column; no longer collected.
  motivation   String? @db.Text // Stores current grade until the contract migration.

  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?   @db.Text
  createdUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewer    User? @relation("ServantApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdUser User? @relation("ServantApplicationCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// A parent's request to register a child for Sunday School. Stays pending
// until a coordinator/admin with authority over the requested level reviews
// it and places the child into an actual class — that's when the real
// SundaySchoolChild row and the parent<->child guardian link get created.
model ChildRegistrationRequest {
  id     String             @id @default(cuid())
  status RegistrationStatus @default(PENDING)

  submittedByUserId  String
  sundaySchoolYearId String?

  firstName     String
  lastName      String
  birthDate     DateTime
  gender        SundaySchoolChildGender?
  intendedLevel SundaySchoolLevel

  // Guardian contact for this request. Pre-filled from the submitting
  // parent's own profile client-side but stored explicitly and editable —
  // not necessarily identical to the parent User's own info.
  guardianName  String
  guardianPhone String
  guardianEmail String?
  notes         String? @db.Text

  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNote            String?   @db.Text
  createdChildId        String?   @unique
  placedClassId         String?
  resultingEnrollmentId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedBy         User                    @relation("ChildRegistrationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewer            User?                   @relation("ChildRegistrationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdChild        SundaySchoolChild?      @relation("ChildRegistrationCreatedChild", fields: [createdChildId], references: [id], onDelete: SetNull)
  placedClass         SundaySchoolClass?      @relation(fields: [placedClassId], references: [id], onDelete: SetNull)
  sundaySchoolYear    SundaySchoolYear?       @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  resultingEnrollment SundaySchoolEnrollment? @relation("ChildRegistrationEnrollment", fields: [resultingEnrollmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedByUserId])
  @@index([intendedLevel])
  @@index([sundaySchoolYearId, status])
  @@index([createdAt])
}

// Many-to-many link between a PARENT User and the SundaySchoolChild rows
// they're a guardian of. Purely additive alongside SundaySchoolChild's
// existing guardianName/Phone/Email text fields, which stay in place for
// children added the old way by staff with no parent account.
model SundaySchoolGuardianProfile {
  id        String                   @id @default(cuid())
  userId    String?                  @unique
  firstName String
  lastName  String
  email     String?
  phone     String?
  status    SundaySchoolRecordStatus @default(ACTIVE)
  createdAt DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)

  user       User?                       @relation("SundaySchoolGuardianAccount", fields: [userId], references: [id], onDelete: SetNull)
  childLinks SundaySchoolChildGuardian[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([status])
}

model SundaySchoolChildGuardian {
  id                String    @id @default(cuid())
  parentId          String
  childId           String
  guardianProfileId String?
  linkedById        String?
  linkedAt          DateTime  @default(now()) @db.Timestamptz(3)
  endedAt           DateTime? @db.Timestamptz(3)
  relationshipLabel String?
  createdAt         DateTime  @default(now())

  parent          User                         @relation("GuardianOfChildren", fields: [parentId], references: [id], onDelete: Restrict)
  child           SundaySchoolChild            @relation("ChildGuardians", fields: [childId], references: [id], onDelete: Restrict)
  guardianProfile SundaySchoolGuardianProfile? @relation(fields: [guardianProfileId], references: [id], onDelete: Restrict)
  linkedBy        User?                        @relation("SundaySchoolGuardianLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)

  @@index([childId, endedAt])
  @@index([parentId, endedAt])
  @@index([guardianProfileId, endedAt])
  @@index([linkedById])
}

model SundaySchoolRosterImport {
  id                 String                         @id @default(cuid())
  sundaySchoolYearId String
  classId            String
  idempotencyKey     String
  requestHash        String
  fileName           String?
  status             SundaySchoolRosterImportStatus @default(PREVIEWED)
  totalRows          Int                            @default(0)
  createdRows        Int                            @default(0)
  matchedRows        Int                            @default(0)
  skippedRows        Int                            @default(0)
  failedRows         Int                            @default(0)
  summary            Json?
  createdById        String
  createdAt          DateTime                       @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?                      @db.Timestamptz(3)

  sundaySchoolYear SundaySchoolYear              @relation(fields: [sundaySchoolYearId], references: [id], onDelete: Restrict)
  class            SundaySchoolClass             @relation(fields: [classId, sundaySchoolYearId], references: [id, sundaySchoolYearId], onDelete: Restrict)
  createdBy        User                          @relation("SundaySchoolRosterImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rows             SundaySchoolRosterImportRow[]

  @@unique([createdById, idempotencyKey])
  @@index([sundaySchoolYearId, status])
  @@index([classId, createdAt])
}

model SundaySchoolRosterImportRow {
  id           String                             @id @default(cuid())
  importId     String
  rowNumber    Int
  outcome      SundaySchoolRosterImportRowOutcome
  childId      String?
  enrollmentId String?
  errorCode    String?
  message      String?                            @db.Text
  createdAt    DateTime                           @default(now()) @db.Timestamptz(3)

  rosterImport SundaySchoolRosterImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  child        SundaySchoolChild?       @relation(fields: [childId], references: [id], onDelete: SetNull)
  enrollment   SundaySchoolEnrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([childId])
  @@index([enrollmentId])
  @@index([outcome])
}

model SundaySchoolRolloverRun {
  id            String                        @id @default(cuid())
  sourceYearId  String
  targetYearId  String
  status        SundaySchoolRolloverRunStatus @default(RUNNING)
  startedAt     DateTime                      @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?                     @db.Timestamptz(3)
  errorSummary  String?                       @db.Text
  triggeredById String?

  sourceYear  SundaySchoolYear           @relation("SundaySchoolRolloverSourceYear", fields: [sourceYearId], references: [id], onDelete: Restrict)
  targetYear  SundaySchoolYear           @relation("SundaySchoolRolloverTargetYear", fields: [targetYearId], references: [id], onDelete: Restrict)
  triggeredBy User?                      @relation("SundaySchoolRolloverTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  items       SundaySchoolRolloverItem[]

  @@unique([sourceYearId, targetYearId])
  @@index([status, startedAt])
  @@index([triggeredById])
}

model SundaySchoolRolloverItem {
  id                 String                          @id @default(cuid())
  rolloverRunId      String
  sourceEnrollmentId String
  targetEnrollmentId String?                         @unique
  disposition        SundaySchoolRolloverDisposition
  sourceLevel        SundaySchoolLevel
  targetLevel        SundaySchoolLevel?
  status             SundaySchoolRolloverItemStatus  @default(PENDING)
  errorCode          String?
  createdAt          DateTime                        @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?                       @db.Timestamptz(3)

  rolloverRun      SundaySchoolRolloverRun @relation(fields: [rolloverRunId], references: [id], onDelete: Cascade)
  sourceEnrollment SundaySchoolEnrollment  @relation("SundaySchoolRolloverSourceEnrollment", fields: [sourceEnrollmentId], references: [id], onDelete: Restrict)
  targetEnrollment SundaySchoolEnrollment? @relation("SundaySchoolRolloverTargetEnrollment", fields: [targetEnrollmentId], references: [id], onDelete: Restrict)

  @@unique([rolloverRunId, sourceEnrollmentId])
  @@index([status])
}

model AuditEvent {
  id          String           @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  result      AuditEventResult
  requestId   String?
  reason      String?
  metadata    Json?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}

// ============================================
// PUSH NOTIFICATION MODELS
// ============================================

enum NotificationType {
  GRADE_POSTED
  ATTENDANCE_RECORDED
  LESSON_SCHEDULED
  LESSON_CANCELLED
  REGISTRATION_RECEIVED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  ASYNC_NOTE_REVIEWED // Legacy: async note review was removed; kept so db push doesn't drop an enum value
  MENTOR_ASSIGNED
  ANNOUNCEMENT
  CONDUCT_REMOVAL
  SERVANT_APPLICATION_RECEIVED
  SERVANT_APPLICATION_REVIEWED
  CHILD_REGISTRATION_RECEIVED
  CHILD_REGISTRATION_REVIEWED
  PRIEST_NOTE_CREATED
  REGISTRATION_INCOMPLETE
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String           @db.Text
  url          String? // Deep link URL within the app
  isRead       Boolean          @default(false)
  isPersistent Boolean          @default(false) // Cannot be read or dismissed until its action is complete
  metadata     Json? // Extra data (studentId, examId, etc.)
  createdAt    DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
}
